#!/bin/sh
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
[ -n "${interface:-}" ] || exit 1
case "$1" in
    deconfig)
        ip link set "$interface" up
        ip -4 addr flush dev "$interface"
        ;;
    bound|renew)
        ip link set "$interface" up
        ip -4 addr flush dev "$interface"
        ip -4 route flush dev "$interface"
        ip addr add "$ip/${mask:-${subnet:-255.255.255.0}}" ${broadcast:+broadcast "$broadcast"} dev "$interface"
        for gateway in ${router:-}; do
            ip route add default via "$gateway" dev "$interface"
            break
        done
        temporary=$(mktemp /etc/resolv.conf.XXXXXX)
        for server in ${dns:-}; do
            printf 'nameserver %s\n' "$server" >>"$temporary"
        done
        if [ -n "${domain:-}" ]; then
            printf 'search %s\n' "$domain" >>"$temporary"
        fi
        chmod 0644 "$temporary"
        mv "$temporary" /etc/resolv.conf
        ;;
esac
